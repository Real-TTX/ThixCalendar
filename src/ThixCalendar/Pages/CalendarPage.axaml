<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ThixCalendar.Controls"
             x:Class="ThixCalendar.Pages.CalendarPage">
  <!--
    "Meine Kalender" (mockup): title with sync and filter (search and "Neuer Termin" are in the header of the window); the accounts as chips with their switch;
    the period with ‹ Heute › and the view (Tag | Arbeitswoche | Woche | Monat); then the day/week grid or the month.
  -->
  <DockPanel Margin="26,18,22,14">
    <!-- Title row: the toolbar of the calendar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,14">
      <TextBlock Text="Meine Kalender" Theme="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,24,0" />
      <Button Grid.Column="2" x:Name="SyncButton" Theme="{StaticResource RoundButton}" Width="42" Height="42" CornerRadius="21" Margin="0,0,8,0"
              Click="OnSyncClick" AutomationProperties.Name="Jetzt synchronisieren">
        <Panel>
          <controls:IconView Data="{StaticResource Icon.Sync}" Width="19" Height="19" />
          <Ellipse x:Name="SyncDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0" />
        </Panel>
      </Button>
      <Button Grid.Column="3" x:Name="FilterButton" Theme="{StaticResource RoundButton}" Width="42" Height="42" CornerRadius="21"
              ToolTip.Tip="Kalender ein- und ausblenden" AutomationProperties.Name="Kalender filtern">
        <controls:IconView Data="{StaticResource Icon.Filter}" Width="18" Height="18" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel x:Name="FilterList" MinWidth="240" Spacing="2" />
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Accounts as chips (mockup): each with its switch -->
    <WrapPanel DockPanel.Dock="Top" x:Name="AccountChips" Margin="0,0,0,12" />

    <!-- Period and view -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="PreviousButton" Theme="{StaticResource RoundButton}" Click="OnPreviousClick" AutomationProperties.Name="Zurück">
          <controls:IconView Data="{StaticResource Icon.ChevronLeft}" Width="18" Height="18" />
        </Button>
        <Button x:Name="TodayButton" Click="OnTodayClick" CornerRadius="19" Padding="16,7" Content="Heute" />
        <Button x:Name="NextButton" Theme="{StaticResource RoundButton}" Click="OnNextClick" AutomationProperties.Name="Weiter">
          <controls:IconView Data="{StaticResource Icon.ChevronRight}" Width="18" Height="18" />
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="RangeTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="RangeSubtitle" Theme="{StaticResource MutedText}" FontSize="14" HorizontalAlignment="Center" />
      </StackPanel>
      <Border Grid.Column="3" Background="{DynamicResource SubtleBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ToggleButton x:Name="DayMode" Theme="{StaticResource Segment}" Content="Tag" Click="OnModeClick" Tag="Day" />
          <ToggleButton x:Name="WorkWeekMode" Theme="{StaticResource Segment}" Content="Arbeitswoche" Click="OnModeClick" Tag="WorkWeek" />
          <ToggleButton x:Name="WeekMode" Theme="{StaticResource Segment}" Content="Woche" Click="OnModeClick" Tag="Week" />
          <ToggleButton x:Name="MonthMode" Theme="{StaticResource Segment}" Content="Monat" Click="OnModeClick" Tag="Month" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Hint while there is nothing to show yet -->
    <controls:InfoBar DockPanel.Dock="Top" x:Name="Hint" />

    <Panel>
      <controls:TimeGridView x:Name="TimeGrid" />
      <controls:MonthView x:Name="Month" IsVisible="False" />
    </Panel>
  </DockPanel>
</UserControl>
