<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixCalendar.Controls"
             x:Class="ThixCalendar.Pages.AccountsPage">
  <!--
    "Konten": every account with its state (the CRUD list): toolbar with search, kind and sort above; the list; the
    actions below (Konto hinzufügen …, Bearbeiten, Synchronisieren … gap … Entfernen).
  -->
  <UserControl.Styles>
    <!-- The rows are drawn by the page (no local colours in code, or these styles could not win). -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.row">
      <Setter Property="Background" Value="{DynamicResource Mat.Selection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mat.Accent}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.row">
      <Setter Property="Background" Value="{DynamicResource Mat.Surface2}" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="26,18,22,16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
      <TextBlock Text="Konten" Theme="{StaticResource MatText.PageTitle}" VerticalAlignment="Center" />
      <TextBlock x:Name="CountText" Theme="{StaticResource MatText.Muted}" FontSize="14" VerticalAlignment="Center" Margin="0,6,0,0" />
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12" ItemSpacing="10" LineSpacing="8">
      <Panel Width="300">
        <TextBox x:Name="SearchBox" Theme="{StaticResource MatSearchBox}" Watermark="Name, E-Mail, Adresse …" AutomationProperties.Name="Konten durchsuchen" />
        <mat:MatIcon Size="18" Icon="search" Margin="13,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Mat.TextMuted}" IsHitTestVisible="False" />
      </Panel>
      <ComboBox x:Name="KindFilter" MinWidth="190" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="Art" />
      <ComboBox x:Name="SortChoice" MinWidth="190" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="Sortierung" />
    </WrapPanel>

    <controls:ActionBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="AddButton" Theme="{StaticResource MatButton.Primary}">
        <controls:IconLabel Icon="plus" Text="Konto hinzufügen" />
        <Button.Flyout>
          <MenuFlyout Placement="TopEdgeAlignedLeft">
            <MenuItem Header="Microsoft 365 / Outlook.com …" Click="OnAddMicrosoftClick" />
            <MenuItem Header="Google Kalender …" Click="OnAddGoogleClick" />
            <MenuItem Header="ICS-Abo (Kalenderadresse) …" Click="OnAddIcsClick" />
            <MenuItem Header="Kalender auf diesem Computer" Click="OnAddLocalClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button x:Name="EditButton" Click="OnEditClick">
        <controls:IconLabel Icon="edit" Text="Bearbeiten" />
      </Button>
      <Button x:Name="ReconnectButton" Click="OnReconnectClick">
        <controls:IconLabel Icon="login" Text="Neu anmelden" />
      </Button>
      <Button x:Name="SyncButton" Click="OnSyncClick">
        <controls:IconLabel Icon="refresh" Text="Jetzt synchronisieren" />
      </Button>
      <Button x:Name="RemoveButton" Theme="{StaticResource MatButton.Danger}" controls:ActionBar.Separated="True" Click="OnRemoveClick">
        <controls:IconLabel Icon="trash" Text="Entfernen" />
      </Button>
    </controls:ActionBar>
    <controls:InfoBar DockPanel.Dock="Bottom" x:Name="Message" Margin="0,10,0,0" />

    <Panel>
      <ListBox x:Name="AccountList" Theme="{StaticResource MatList}" ItemContainerTheme="{StaticResource PlainRow}" SelectionMode="Single" />
      <!-- Nothing connected yet: the three ways in -->
      <Border x:Name="EmptyCard" Theme="{StaticResource MatCard}" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" IsVisible="False">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <mat:MatIcon Size="30" Icon="calendar-plus" Foreground="{DynamicResource Mat.Accent}" />
            <TextBlock Text="Private und geschäftliche Kalender an einem Ort" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Theme="{StaticResource MatText.Muted}" FontSize="14" TextWrapping="Wrap"
                     Text="Verbinde dein Microsoft-365-Konto (Arbeit) und deinen Google Kalender (privat). ThixCalendar zeigt alles zusammen und erinnert dich so, dass du keinen Termin mehr verpasst." />
          <controls:ActionBar>
            <Button Theme="{StaticResource MatButton.Primary}" Click="OnAddMicrosoftClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:AccountMark Kind="Microsoft" Width="16" Height="16" />
                <TextBlock Text="Microsoft 365" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Click="OnAddGoogleClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:AccountMark Kind="Google" Width="16" Height="16" />
                <TextBlock Text="Google" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Click="OnAddIcsClick">
              <controls:IconLabel Icon="rss" Text="ICS-Abo" />
            </Button>
            <Button Click="OnAddLocalClick">
              <controls:IconLabel Icon="home" Text="Eigene Kalender" />
            </Button>
          </controls:ActionBar>
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
