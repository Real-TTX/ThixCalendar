<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ThixCalendar.Controls"
             x:Class="ThixCalendar.Pages.AccountsPage">
  <!--
    "Konten": every account with its state (the CRUD list): toolbar with search, kind and sort above; the list; the
    actions below (Konto hinzufügen …, Bearbeiten, Synchronisieren … gap … Entfernen).
  -->
  <UserControl.Styles>
    <!-- The rows are drawn by the page (no local colours in code, or these styles could not win). -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.row">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.row">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="26,18,22,16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
      <TextBlock Text="Konten" Theme="{StaticResource PageTitle}" VerticalAlignment="Center" />
      <TextBlock x:Name="CountText" Theme="{StaticResource MutedText}" FontSize="14" VerticalAlignment="Center" Margin="0,6,0,0" />
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12" ItemSpacing="10" LineSpacing="8">
      <Panel Width="300">
        <TextBox x:Name="SearchBox" Theme="{StaticResource SearchBox}" Watermark="Name, E-Mail, Adresse …" AutomationProperties.Name="Konten durchsuchen" />
        <controls:IconView Data="{StaticResource Icon.Search}" Width="18" Height="18" Margin="13,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
      </Panel>
      <ComboBox x:Name="KindFilter" MinWidth="190" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="Art" />
      <ComboBox x:Name="SortChoice" MinWidth="190" MinHeight="40" VerticalContentAlignment="Center" AutomationProperties.Name="Sortierung" />
    </WrapPanel>

    <controls:ActionBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="AddButton" Theme="{StaticResource PrimaryButton}">
        <controls:IconLabel Icon="{StaticResource Icon.Plus}" Text="Konto hinzufügen" />
        <Button.Flyout>
          <MenuFlyout Placement="TopEdgeAlignedLeft">
            <MenuItem Header="Microsoft 365 / Outlook.com …" Click="OnAddMicrosoftClick" />
            <MenuItem Header="Google Kalender …" Click="OnAddGoogleClick" />
            <MenuItem Header="ICS-Abo (Kalenderadresse) …" Click="OnAddIcsClick" />
            <MenuItem Header="Kalender auf diesem Computer" Click="OnAddLocalClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button x:Name="EditButton" Click="OnEditClick">
        <controls:IconLabel Icon="{StaticResource Icon.Edit}" Text="Bearbeiten" />
      </Button>
      <Button x:Name="ReconnectButton" Click="OnReconnectClick">
        <controls:IconLabel Icon="{StaticResource Icon.Login}" Text="Neu anmelden" />
      </Button>
      <Button x:Name="SyncButton" Click="OnSyncClick">
        <controls:IconLabel Icon="{StaticResource Icon.Sync}" Text="Jetzt synchronisieren" />
      </Button>
      <Button x:Name="RemoveButton" Theme="{StaticResource DangerButton}" controls:ActionBar.Separated="True" Click="OnRemoveClick">
        <controls:IconLabel Icon="{StaticResource Icon.Delete}" Text="Entfernen" />
      </Button>
    </controls:ActionBar>
    <controls:InfoBar DockPanel.Dock="Bottom" x:Name="Message" Margin="0,10,0,0" />

    <Panel>
      <ListBox x:Name="AccountList" Theme="{StaticResource PlainList}" ItemContainerTheme="{StaticResource PlainRow}" SelectionMode="Single" />
      <!-- Nothing connected yet: the three ways in -->
      <Border x:Name="EmptyCard" Theme="{StaticResource Card}" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" IsVisible="False">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <controls:IconView Data="{StaticResource Icon.CalendarPlus}" Width="30" Height="30" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Private und geschäftliche Kalender an einem Ort" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Theme="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap"
                     Text="Verbinde dein Microsoft-365-Konto (Arbeit) und deinen Google Kalender (privat). ThixCalendar zeigt alles zusammen und erinnert dich so, dass du keinen Termin mehr verpasst." />
          <controls:ActionBar>
            <Button Theme="{StaticResource PrimaryButton}" Click="OnAddMicrosoftClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:AccountMark Kind="Microsoft" Width="16" Height="16" />
                <TextBlock Text="Microsoft 365" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Click="OnAddGoogleClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:AccountMark Kind="Google" Width="16" Height="16" />
                <TextBlock Text="Google" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Click="OnAddIcsClick">
              <controls:IconLabel Icon="{StaticResource Icon.Rss}" Text="ICS-Abo" />
            </Button>
            <Button Click="OnAddLocalClick">
              <controls:IconLabel Icon="{StaticResource Icon.Home}" Text="Auf diesem Computer" />
            </Button>
          </controls:ActionBar>
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
