<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <!--
    The few looks of ThixCalendar's own. Everything else is MatDesktop's (MatDesktop/, copied from MatDesign): the colours
    (Mat.Surface, Mat.TextMuted, Mat.Accent …, light and dark), the fonts and sizes, and the named looks (MatButton.Primary,
    MatText.PageTitle, MatCard, MatSearchBox, MatList …). No literal colour here: only Mat.* tokens. App.Initialize loads this
    dictionary after MatTheme.Install, so it can build on MatDesktop's themes.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- How strongly an event is filled with its calendar colour (Ui.Tint). -->
      <sys:Double x:Key="EventTintOpacity">0.16</sys:Double>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <sys:Double x:Key="EventTintOpacity">0.28</sys:Double>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- A quiet box inside a page or card (a hint, a summary). -->
  <ControlTheme x:Key="SubtleCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Mat.Surface2}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mat.Radius}" />
    <Setter Property="Padding" Value="14,12" />
  </ControlTheme>

  <!-- A row of a list whose look the page draws itself (Border.row in the page's styles: chosen, hover). -->
  <ControlTheme x:Key="PlainRow" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Mat.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- A segment of the view switcher (Tag | Arbeitswoche | Woche | Monat): the chosen one lifted onto the surface. -->
  <ControlTheme x:Key="Segment" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Mat.TextMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Mat.RadiusSm}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Mat.Text}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Mat.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mat.Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource Mat.Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Mat.FocusRing}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </ControlTheme>

  <!-- A round icon button (‹ › of the calendar, sync, filter, the pager). -->
  <ControlTheme x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>
</ResourceDictionary>
