<mat:MatWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mat="using:MatDesktop"
               xmlns:controls="using:ThixCalendar.Controls"
               x:Class="ThixCalendar.MainWindow"
               Title="ThixCalendar" Width="1320" Height="840" MinWidth="760" MinHeight="520"
               WindowStartupLocation="CenterScreen">
  <!--
    The one window of ThixCalendar in MatDesktop's chrome, like ThixClip: the title bar (DESK-03: logo and word mark, the
    search over all events and "Neuer Termin" in the middle, the caption buttons on Windows, the traffic lights on macOS),
    the menu (DESK-04: Kalender, Termine, Konten, Einstellungen below a line; at its foot "Meine Kalender" with their
    switches, the small month, the state of the reminders and of MatCloud, the version = About and the fold to a rail) and
    the page. Closing it only hides it: ThixCalendar keeps reminding from the tray / menu bar.
  -->
  <Grid RowDefinitions="Auto,*">
    <mat:MatTitleBar x:Name="TitleBar" AppName="ThixCalendar">
      <mat:MatTitleBar.WordMark>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Mat.FontSizeXl}" FontWeight="SemiBold">
          <Run Text="Thix" /><Run Text="Calendar" Foreground="{DynamicResource Mat.AccentText}" />
        </TextBlock>
      </mat:MatTitleBar.WordMark>
      <mat:MatTitleBar.Center>
        <Grid ColumnDefinitions="*,Auto">
          <!-- Search over all events: typing shows the list "Termine" with the result -->
          <TextBox x:Name="SearchBox" Theme="{StaticResource MatSearchBox}" MaxWidth="620" HorizontalAlignment="Stretch"
                   Watermark="Termine, Personen, Orte suchen" AutomationProperties.Name="Termine suchen" />
          <Button Grid.Column="1" x:Name="NewEventButton" Theme="{StaticResource MatButton.Primary}" Click="OnNewEventClick" Margin="12,0,10,0"
                  VerticalAlignment="Center">
            <controls:IconLabel Icon="plus" Text="Neuer Termin" />
          </Button>
        </Grid>
      </mat:MatTitleBar.Center>
    </mat:MatTitleBar>

    <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="Auto,*">
      <!-- The menu; its foot gets "Meine Kalender", the small month and the states (MainWindow.BuildMenuFoot) -->
      <mat:MatNav x:Name="Sidebar" AppName="ThixCalendar" />
      <Border Grid.Column="1" x:Name="PageArea" Background="{DynamicResource Mat.Surface}" ClipToBounds="True">
        <ContentControl x:Name="PageHost" />
      </Border>
    </Grid>
  </Grid>
</mat:MatWindow>
