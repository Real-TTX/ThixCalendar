<Project>
  <!--
    The app registrations of ThixCalendar for LOCAL builds (docs/APP-REGISTRIERUNG.md). Copy this file to
    secrets.local.props (ignored by git) and fill in the values; Directory.Build.props imports it. CI uses the repository
    secrets THIXCALENDAR_MICROSOFT_CLIENT_ID, THIXCALENDAR_GOOGLE_CLIENT_ID and THIXCALENDAR_GOOGLE_CLIENT_SECRET instead.
  -->
  <PropertyGroup>
    <!-- Microsoft is built in (Directory.Build.props); set MicrosoftClientId here only to override it. -->
    <GoogleClientId></GoogleClientId>
    <GoogleClientSecret></GoogleClientSecret>
  </PropertyGroup>
</Project>
